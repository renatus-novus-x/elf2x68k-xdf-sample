TARGET = crtc60hz.x
XDF = crtc60hz.xdf
ZIP = crtc60hz.zip

CROSS = m68k-xelf-
CC = $(CROSS)gcc
AS = $(CROSS)as
LD = $(CROSS)gcc

CFLAGS = -m68000 -O2 -g
LDFLAGS =

PYTHON ?= python3
CURL ?= curl
UNAR ?= unar

#
# Working directories/files
#
BUILD_DIR := build
XDF_ROOT := $(BUILD_DIR)/xdfroot

HUMAN_LZH := $(BUILD_DIR)/HUMN302I.LZH
HUMAN_XDF := $(BUILD_DIR)/HUMAN302.XDF

HUMAN_EXTRACT_DIR := $(BUILD_DIR)/human302
HUMAN_EXTRACT_STAMP := $(HUMAN_EXTRACT_DIR)/.extracted

#
# Keep the Human68k license internally under an ASCII filename.
# The contents are copied byte-for-byte without character conversion.
#
LICENSE_TEXT := $(BUILD_DIR)/LICENSE.TXT

XDFTOOL := $(BUILD_DIR)/xdftool.py

#
# Helper scripts generated by this Makefile.
#
AUTOEXEC_PATCHER := $(BUILD_DIR)/patch_autoexec.py
ZIPPER := $(BUILD_DIR)/make_sjis_zip.py

#
# Download sources
#
HUMAN_URL := http://retropc.net/x68000/software/sharp/human302/HUMN302I.LZH

#
# Pin xdftool.py to a known revision for reproducible builds.
#
XDFTOOL_URL := https://raw.githubusercontent.com/yunkya2/x68kmisc/08f647bad280dc8eac778f3f98358350d10e9471/xdftool/xdftool.py


.PHONY: all clean distclean check-xdf check-tools


#
# Build everything.
#
all: check-tools $(TARGET) $(XDF) $(ZIP)


#
# Check required host tools.
#
check-tools:
	@command -v $(CC) >/dev/null 2>&1 || { \
		echo "Error: $(CC) was not found." >&2; \
		echo "Make sure elf2x68k is installed and available in PATH." >&2; \
		exit 1; \
	}
	@command -v $(PYTHON) >/dev/null 2>&1 || { \
		echo "Error: $(PYTHON) is not installed." >&2; \
		exit 1; \
	}
	@command -v $(CURL) >/dev/null 2>&1 || { \
		echo "Error: $(CURL) is not installed." >&2; \
		exit 1; \
	}
	@command -v $(UNAR) >/dev/null 2>&1 || { \
		echo "Error: $(UNAR) is not installed." >&2; \
		echo "Install it with: sudo apt install unar" >&2; \
		exit 1; \
	}


#
# Build crtc60hz.x with elf2x68k.
#
$(TARGET): crtc60hz.o
	$(LD) $(LDFLAGS) -o $@ $^

%.o: %.c
	$(CC) $(CFLAGS) -c $<


#
# Build directory.
#
$(BUILD_DIR):
	mkdir -p $@


#
# Download Human68k 3.02 archive.
#
$(HUMAN_LZH): | $(BUILD_DIR)
	$(CURL) -L --fail --show-error -o $@ $(HUMAN_URL)


#
# Extract the Human68k archive.
#
# -e shift_jis:
#   Interpret filenames in the LZH archive as Shift_JIS.
#
# -D:
#   Do not create an extra enclosing directory.
#
# File contents are NOT converted.
#
$(HUMAN_EXTRACT_STAMP): $(HUMAN_LZH)
	rm -rf $(HUMAN_EXTRACT_DIR)
	mkdir -p $(HUMAN_EXTRACT_DIR)

	$(UNAR) \
		-e shift_jis \
		-D \
		-f \
		-o $(HUMAN_EXTRACT_DIR) \
		$(HUMAN_LZH)

	@src="$$(find $(HUMAN_EXTRACT_DIR) \
		-maxdepth 1 \
		-type f \
		-iname 'HUMAN302.XDF' \
		-print -quit)"; \
	test -n "$$src" || { \
		echo "Error: HUMAN302.XDF was not found." >&2; \
		exit 1; \
	}

	@src="$$(find $(HUMAN_EXTRACT_DIR) \
		-maxdepth 1 \
		-type f \
		-iname '*.txt' \
		-print -quit)"; \
	test -n "$$src" || { \
		echo "Error: Human68k license text was not found." >&2; \
		exit 1; \
	}

	touch $@


#
# Copy HUMAN302.XDF from the extracted archive.
#
$(HUMAN_XDF): $(HUMAN_EXTRACT_STAMP)
	@src="$$(find $(HUMAN_EXTRACT_DIR) \
		-maxdepth 1 \
		-type f \
		-iname 'HUMAN302.XDF' \
		-print -quit)"; \
	test -n "$$src" || { \
		echo "Error: HUMAN302.XDF was not found." >&2; \
		exit 1; \
	}; \
	cp "$$src" $@

	@echo "Copied Human68k XDF: $(HUMAN_XDF)"


#
# Copy the Human68k license without character conversion.
#
# The original filename contains Japanese characters.  Locate it by
# extension instead of referring to the filename directly.
#
$(LICENSE_TEXT): $(HUMAN_EXTRACT_STAMP)
	@src="$$(find $(HUMAN_EXTRACT_DIR) \
		-maxdepth 1 \
		-type f \
		-iname '*.txt' \
		-print -quit)"; \
	test -n "$$src" || { \
		echo "Error: Human68k license text was not found." >&2; \
		exit 1; \
	}; \
	cp "$$src" $@

	@echo "Copied Human68k license: $(LICENSE_TEXT)"


#
# Download XDFtool.
#
$(XDFTOOL): | $(BUILD_DIR)
	$(CURL) -L --fail --show-error -o $@ $(XDFTOOL_URL)
	chmod +x $@


#
# Generate a helper that appends the executable to AUTOEXEC.BAT.
#
# AUTOEXEC.BAT is handled entirely as binary data so that any existing
# Shift_JIS text remains untouched.
#
# If a DOS/Human68k EOF marker (0x1a) is present, the new command is
# inserted before the marker.
#
# The command is not duplicated if it already exists.
#
$(AUTOEXEC_PATCHER): Makefile | $(BUILD_DIR)
	@printf '%s\n' \
	'import sys' \
	'' \
	'path = sys.argv[1]' \
	'command = sys.argv[2].encode("ascii")' \
	'' \
	'with open(path, "rb") as f:' \
	'    data = f.read()' \
	'' \
	'eof = data.endswith(b"\x1a")' \
	'body = data[:-1] if eof else data' \
	'' \
	'normalized = body.replace(b"\r\n", b"\n").replace(b"\r", b"\n")' \
	'lines = [line.strip().lower() for line in normalized.split(b"\n")]' \
	'' \
	'if command.lower() not in lines:' \
	'    if body.endswith(b"\r"):' \
	'        body += b"\n"' \
	'    elif body and not body.endswith(b"\n"):' \
	'        body += b"\r\n"' \
	'' \
	'    body += command + b"\r\n"' \
	'' \
	'if eof:' \
	'    body += b"\x1a"' \
	'' \
	'with open(path, "wb") as f:' \
	'    f.write(body)' \
	> $@


#
# Create a bootable Human68k XDF containing crtc60hz.x.
#
$(XDF): Makefile $(TARGET) $(HUMAN_XDF) $(XDFTOOL) $(AUTOEXEC_PATCHER)
	rm -rf $(XDF_ROOT)
	mkdir -p $(XDF_ROOT)

	#
	# Extract the original Human68k disk.
	#
	cd $(XDF_ROOT) && \
		$(PYTHON) ../xdftool.py x ../HUMAN302.XDF

	#
	# Human.sys must be present for booting.
	#
	@find $(XDF_ROOT) \
		-maxdepth 1 \
		-type f \
		-iname 'human.sys' \
		-print -quit | grep -q . || { \
		echo "Error: Human.sys was not found." >&2; \
		exit 1; \
	}

	#
	# AUTOEXEC.BAT must be present.
	#
	@autoexec="$$(find $(XDF_ROOT) \
		-maxdepth 1 \
		-type f \
		-iname 'autoexec.bat' \
		-print -quit)"; \
	test -n "$$autoexec" || { \
		echo "Error: AUTOEXEC.BAT was not found." >&2; \
		exit 1; \
	}

	#
	# Add the newly built executable to the root directory.
	#
	cp $(TARGET) $(XDF_ROOT)/$(TARGET)

	#
	# Append crtc60hz.x to AUTOEXEC.BAT so that the program starts
	# automatically after Human68k boots.
	#
	@autoexec="$$(find $(XDF_ROOT) \
		-maxdepth 1 \
		-type f \
		-iname 'autoexec.bat' \
		-print -quit)"; \
	$(PYTHON) $(AUTOEXEC_PATCHER) "$$autoexec" "$(TARGET)"

	@echo "Added $(TARGET) to AUTOEXEC.BAT"

	#
	# Re-create a bootable X68000 2HD (1232 KB) XDF.
	#
	cd $(XDF_ROOT) && \
		$(PYTHON) ../xdftool.py c ../../$(XDF) *

	@echo
	@echo "Created bootable XDF: $(XDF)"


#
# Generate a ZIP creation helper.
#
# The Japanese license filename is written as Shift_JIS bytes into the
# ZIP directory entry.  The license file contents themselves are never
# character-code converted.
#
$(ZIPPER): Makefile | $(BUILD_DIR)
	@printf '%s\n' \
	'import os' \
	'import sys' \
	'import time' \
	'import zipfile' \
	'' \
	'class ShiftJISZipInfo(zipfile.ZipInfo):' \
	'    def _encodeFilenameFlags(self):' \
	'        return self.filename.encode("shift_jis"), self.flag_bits & ~0x800' \
	'' \
	'def add_file(zf, src, arcname):' \
	'    st = os.stat(src)' \
	'    tm = time.localtime(st.st_mtime)' \
	'' \
	'    zi = ShiftJISZipInfo(arcname)' \
	'    zi.date_time = tm[:6]' \
	'    zi.compress_type = zipfile.ZIP_DEFLATED' \
	'    zi.external_attr = (st.st_mode & 0xffff) << 16' \
	'' \
	'    with open(src, "rb") as f:' \
	'        data = f.read()' \
	'' \
	'    zf.writestr(zi, data)' \
	'' \
	'outfile = sys.argv[1]' \
	'xdf_file = sys.argv[2]' \
	'license_file = sys.argv[3]' \
	'' \
	'# Japanese filename: "license conditions" from Human68k archive.' \
	'license_name = "\u8a31\u8afe\u6761\u4ef6.txt"' \
	'' \
	'with zipfile.ZipFile(outfile, "w") as zf:' \
	'    add_file(zf, xdf_file, os.path.basename(xdf_file))' \
	'    add_file(zf, license_file, license_name)' \
	> $@


#
# Create the distribution ZIP.
#
# Contents:
#
#   crtc60hz.xdf
#   Human68k license text
#
$(ZIP): Makefile $(XDF) $(LICENSE_TEXT) $(ZIPPER)
	rm -f $(ZIP)

	$(PYTHON) $(ZIPPER) \
		$(ZIP) \
		$(XDF) \
		$(LICENSE_TEXT)

	@echo
	@echo "Created distribution archive: $(ZIP)"


#
# Display the contents of the generated XDF.
#
check-xdf: $(XDF) $(XDFTOOL)
	$(PYTHON) $(XDFTOOL) t $(XDF)


#
# Remove generated products while keeping downloaded support files.
#
clean:
	-rm -f *.o *.elf* $(TARGET) $(XDF) $(ZIP)
	-rm -rf $(XDF_ROOT)


#
# Remove all downloaded/generated support files as well.
#
distclean: clean
	-rm -rf $(BUILD_DIR)