TARGET = teapot.x
MODEL = model.obj

HDF = teapot.hdf
HDF_FORMAT = /h10

ZIP = teapot.zip

CROSS = m68k-xelf-
CC = $(CROSS)gcc
AS = $(CROSS)as
LD = $(CROSS)gcc

CFLAGS = -m68000 -O2 -g
LDFLAGS =

PYTHON ?= python3
CURL ?= curl
UNAR ?= unar

#
# Working directories/files
#
BUILD_DIR := build
HDF_ROOT := $(BUILD_DIR)/hdfroot

#
# Human68k 3.02 source archive / floppy image
#
HUMAN_LZH := $(BUILD_DIR)/HUMN302I.LZH
HUMAN_XDF := $(BUILD_DIR)/HUMAN302.XDF

HUMAN_EXTRACT_DIR := $(BUILD_DIR)/human302
HUMAN_EXTRACT_STAMP := $(HUMAN_EXTRACT_DIR)/.extracted

#
# Keep the Human68k license internally under an ASCII filename.
# Its contents remain byte-for-byte identical to the original file.
#
LICENSE_TEXT := $(BUILD_DIR)/LICENSE.TXT

#
# XDF/HDF tool
#
XDFTOOL := $(BUILD_DIR)/xdftool.py

#
# Helper scripts generated by this Makefile
#
AUTOEXEC_PATCHER := $(BUILD_DIR)/patch_autoexec.py
ZIPPER := $(BUILD_DIR)/make_sjis_zip.py

#
# Download sources
#
HUMAN_URL := http://retropc.net/x68000/software/sharp/human302/HUMN302I.LZH

#
# Pin xdftool.py to a known revision for reproducible builds.
#
XDFTOOL_URL := https://raw.githubusercontent.com/yunkya2/x68kmisc/08f647bad280dc8eac778f3f98358350d10e9471/xdftool/xdftool.py


.PHONY: all clean distclean check-hdf check-tools


#
# Build everything.
#
all: check-tools $(TARGET) $(HDF) $(ZIP)


#
# Check required host tools and source files.
#
check-tools:
	@command -v $(CC) >/dev/null 2>&1 || { \
		echo "Error: $(CC) was not found." >&2; \
		echo "Make sure elf2x68k is installed and available in PATH." >&2; \
		exit 1; \
	}
	@command -v $(PYTHON) >/dev/null 2>&1 || { \
		echo "Error: $(PYTHON) is not installed." >&2; \
		exit 1; \
	}
	@command -v $(CURL) >/dev/null 2>&1 || { \
		echo "Error: $(CURL) is not installed." >&2; \
		exit 1; \
	}
	@command -v $(UNAR) >/dev/null 2>&1 || { \
		echo "Error: $(UNAR) is not installed." >&2; \
		echo "Install it with: sudo apt install unar" >&2; \
		exit 1; \
	}
	@test -f $(MODEL) || { \
		echo "Error: $(MODEL) was not found." >&2; \
		exit 1; \
	}


#
# Build teapot.x with elf2x68k.
#
$(TARGET): teapot.o
	$(LD) $(LDFLAGS) -o $@ $^

%.o: %.c
	$(CC) $(CFLAGS) -c $<


#
# Build directory.
#
$(BUILD_DIR):
	mkdir -p $@


#
# Download Human68k 3.02 archive.
#
$(HUMAN_LZH): | $(BUILD_DIR)
	$(CURL) -L --fail --show-error -o $@ $(HUMAN_URL)


#
# Extract the Human68k archive.
#
# -e shift_jis:
#   Interpret filenames stored in the LZH archive as Shift_JIS.
#
# -D:
#   Do not create an extra enclosing directory.
#
# File contents are NOT converted.
#
$(HUMAN_EXTRACT_STAMP): $(HUMAN_LZH)
	rm -rf $(HUMAN_EXTRACT_DIR)
	mkdir -p $(HUMAN_EXTRACT_DIR)

	$(UNAR) \
		-e shift_jis \
		-D \
		-f \
		-o $(HUMAN_EXTRACT_DIR) \
		$(HUMAN_LZH)

	@src="$$(find $(HUMAN_EXTRACT_DIR) \
		-maxdepth 1 \
		-type f \
		-iname 'HUMAN302.XDF' \
		-print -quit)"; \
	test -n "$$src" || { \
		echo "Error: HUMAN302.XDF was not found." >&2; \
		exit 1; \
	}

	@src="$$(find $(HUMAN_EXTRACT_DIR) \
		-maxdepth 1 \
		-type f \
		-iname '*.txt' \
		-print -quit)"; \
	test -n "$$src" || { \
		echo "Error: Human68k license text was not found." >&2; \
		exit 1; \
	}

	touch $@


#
# Copy HUMAN302.XDF from the extracted archive.
#
# This floppy image is used only as the source of the Human68k files.
#
$(HUMAN_XDF): $(HUMAN_EXTRACT_STAMP)
	@src="$$(find $(HUMAN_EXTRACT_DIR) \
		-maxdepth 1 \
		-type f \
		-iname 'HUMAN302.XDF' \
		-print -quit)"; \
	test -n "$$src" || { \
		echo "Error: HUMAN302.XDF was not found." >&2; \
		exit 1; \
	}; \
	cp "$$src" $@

	@echo "Copied Human68k XDF: $(HUMAN_XDF)"


#
# Copy the Human68k license without character conversion.
#
$(LICENSE_TEXT): $(HUMAN_EXTRACT_STAMP)
	@src="$$(find $(HUMAN_EXTRACT_DIR) \
		-maxdepth 1 \
		-type f \
		-iname '*.txt' \
		-print -quit)"; \
	test -n "$$src" || { \
		echo "Error: Human68k license text was not found." >&2; \
		exit 1; \
	}; \
	cp "$$src" $@

	@echo "Copied Human68k license: $(LICENSE_TEXT)"


#
# Download XDFtool.
#
# Despite its name, xdftool.py also supports SASI HDF images.
#
$(XDFTOOL): | $(BUILD_DIR)
	$(CURL) -L --fail --show-error -o $@ $(XDFTOOL_URL)
	chmod +x $@


#
# Generate AUTOEXEC.BAT patch helper.
#
# AUTOEXEC.BAT is handled as binary data so that existing
# Shift_JIS contents are not modified.
#
# If a DOS/Human68k EOF marker (0x1a) exists, the command is
# inserted immediately before it.
#
$(AUTOEXEC_PATCHER): Makefile | $(BUILD_DIR)
	@printf '%s\n' \
	'import sys' \
	'' \
	'path = sys.argv[1]' \
	'command = sys.argv[2].encode("ascii")' \
	'' \
	'with open(path, "rb") as f:' \
	'    data = f.read()' \
	'' \
	'eof = data.endswith(b"\x1a")' \
	'body = data[:-1] if eof else data' \
	'' \
	'normalized = body.replace(b"\r\n", b"\n").replace(b"\r", b"\n")' \
	'lines = [line.strip().lower() for line in normalized.split(b"\n")]' \
	'' \
	'if command.lower() not in lines:' \
	'    if body.endswith(b"\r"):' \
	'        body += b"\n"' \
	'    elif body and not body.endswith(b"\n"):' \
	'        body += b"\r\n"' \
	'' \
	'    body += command + b"\r\n"' \
	'' \
	'if eof:' \
	'    body += b"\x1a"' \
	'' \
	'with open(path, "wb") as f:' \
	'    f.write(body)' \
	> $@


#
# Create a bootable Human68k SASI HDF.
#
# HUMAN302.XDF is first extracted into a temporary host directory.
#
# teapot.x and model.obj are then added and AUTOEXEC.BAT is patched:
#
#     teapot.x model.obj
#
# Finally xdftool creates a 10 MB SASI HDD image.
#
$(HDF): Makefile $(TARGET) $(MODEL) $(HUMAN_XDF) $(XDFTOOL) $(AUTOEXEC_PATCHER)
	rm -rf $(HDF_ROOT)
	mkdir -p $(HDF_ROOT)

	#
	# Extract all files from the original Human68k floppy.
	#
	cd $(HDF_ROOT) && \
		$(PYTHON) ../xdftool.py x ../HUMAN302.XDF

	#
	# Human.sys must be present for booting.
	#
	@find $(HDF_ROOT) \
		-maxdepth 1 \
		-type f \
		-iname 'human.sys' \
		-print -quit | grep -q . || { \
		echo "Error: Human.sys was not found." >&2; \
		exit 1; \
	}

	#
	# AUTOEXEC.BAT must be present.
	#
	@autoexec="$$(find $(HDF_ROOT) \
		-maxdepth 1 \
		-type f \
		-iname 'autoexec.bat' \
		-print -quit)"; \
	test -n "$$autoexec" || { \
		echo "Error: AUTOEXEC.BAT was not found." >&2; \
		exit 1; \
	}

	#
	# Add the newly built executable and OBJ model.
	#
	cp $(TARGET) $(HDF_ROOT)/$(TARGET)
	cp $(MODEL) $(HDF_ROOT)/$(MODEL)

	#
	# Run the OBJ viewer automatically after Human68k boots:
	#
	#     teapot.x model.obj
	#
	@autoexec="$$(find $(HDF_ROOT) \
		-maxdepth 1 \
		-type f \
		-iname 'autoexec.bat' \
		-print -quit)"; \
	$(PYTHON) $(AUTOEXEC_PATCHER) \
		"$$autoexec" \
		"$(TARGET) $(MODEL)"

	@echo "Added '$(TARGET) $(MODEL)' to AUTOEXEC.BAT"

	#
	# Create a bootable 10 MB SASI Human68k HDD image.
	#
	cd $(HDF_ROOT) && \
		$(PYTHON) ../xdftool.py c $(HDF_FORMAT) ../../$(HDF) *

	@echo
	@echo "Created bootable SASI HDF: $(HDF)"
	@ls -lh $(HDF)


#
# Generate ZIP creation helper.
#
# The Japanese Human68k license filename is stored using Shift_JIS
# bytes. The file contents are not character-code converted.
#
$(ZIPPER): Makefile | $(BUILD_DIR)
	@printf '%s\n' \
	'import os' \
	'import sys' \
	'import time' \
	'import zipfile' \
	'' \
	'class ShiftJISZipInfo(zipfile.ZipInfo):' \
	'    def _encodeFilenameFlags(self):' \
	'        return self.filename.encode("shift_jis"), self.flag_bits & ~0x800' \
	'' \
	'def add_file(zf, src, arcname):' \
	'    st = os.stat(src)' \
	'    tm = time.localtime(st.st_mtime)' \
	'    zi = ShiftJISZipInfo(arcname)' \
	'    zi.date_time = tm[:6]' \
	'    zi.compress_type = zipfile.ZIP_DEFLATED' \
	'    zi.external_attr = (st.st_mode & 0xffff) << 16' \
	'    with open(src, "rb") as f:' \
	'        data = f.read()' \
	'    zf.writestr(zi, data)' \
	'' \
	'outfile = sys.argv[1]' \
	'hdf_file = sys.argv[2]' \
	'license_file = sys.argv[3]' \
	'' \
	'license_name = "\u8a31\u8afe\u6761\u4ef6.txt"' \
	'' \
	'with zipfile.ZipFile(outfile, "w") as zf:' \
	'    add_file(zf, hdf_file, os.path.basename(hdf_file))' \
	'    add_file(zf, license_file, license_name)' \
	> $@


#
# Create distribution ZIP.
#
# Contents:
#
#     teapot.hdf
#     Human68k license text
#
$(ZIP): Makefile $(HDF) $(LICENSE_TEXT) $(ZIPPER)
	rm -f $(ZIP)

	$(PYTHON) $(ZIPPER) \
		$(ZIP) \
		$(HDF) \
		$(LICENSE_TEXT)

	@echo
	@echo "Created distribution archive: $(ZIP)"


#
# Display the files contained in the generated HDF.
#
check-hdf: $(HDF) $(XDFTOOL)
	$(PYTHON) $(XDFTOOL) t $(HDF)


#
# Remove generated build products while keeping downloads.
#
clean:
	-rm -f *.o *.elf* $(TARGET) $(HDF) $(ZIP)
	-rm -rf $(HDF_ROOT)


#
# Remove downloaded/generated support files as well.
#
distclean: clean
	-rm -rf $(BUILD_DIR)